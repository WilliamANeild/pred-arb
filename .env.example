# Copy to .env and fill in.  .env is gitignored — NEVER commit real keys.

# =============================== KALSHI API ===============================
# Environment: "demo" (paper money, safe) or "prod" (REAL money).
# Start with demo. Only switch to prod once fills are proven on demo.
KALSHI_ENV=demo
# Key ID (UUID) from Kalshi Profile -> API Keys. Demo and prod keys are SEPARATE.
KALSHI_KEY_ID=
# Path to the RSA private key PEM you downloaded when creating the API key.
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi_private_key.pem

# ============================= POLYMARKET API =============================
# Read-only market data needs no key. Trading (later) needs an L2 API key +
# a funded wallet; left blank keeps Polymarket read-only.
POLYMARKET_ENABLED=true
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# ========================= LIVE-TRADING MASTER SWITCH =====================
# Real orders require ALL of: ALLOW_LIVE_TRADING=true AND KALSHI_ENV=prod AND
# the per-run --live flag AND interactive confirmation AND passing every cap.
# Leave false until you have deliberately decided to go live.
ALLOW_LIVE_TRADING=false

# Emergency stop. Set true to block ALL order placement instantly (paper or live).
# You can also create an empty file at data/KILL (or run scripts/panic.py) to stop
# a running bot without editing this file.
KILL_SWITCH=false

# ============================== RISK CAPS =================================
# Deliberately tiny defaults for real-money onboarding. Raise only after paper proof.
BANKROLL_USD=100                   # notional bankroll used for confidence sizing
MAX_CONTRACTS_PER_ORDER=20         # max contracts in any single order
MAX_NOTIONAL_PER_MARKET_USD=25     # max $ risked on one market
MAX_NOTIONAL_PER_GROUP_USD=40      # max $ across all legs of one arb group
MAX_TOTAL_NOTIONAL_USD=100         # max $ deployed across all markets this run
DAILY_LOSS_LIMIT_USD=50            # stop trading for the day after this realized loss

# --- Circuit breakers / runaway protection ---
MAX_PRICE_CENTS=97            # never pay more than this per contract (bug guard)
MAX_ORDERS_PER_SESSION=25     # hard cap on orders placed in one run
MAX_CONSECUTIVE_ERRORS=3      # after this many order errors in a row -> auto-KILL
FEED_STALENESS_SECONDS=120    # if a market snapshot is older than this, don't trade it

# ======================= ARBITRAGE STRATEGY GUARDS =======================
# true = real orders ONLY on riskless dutch-book locks (guaranteed-profit legs).
# This forbids relative-value / basis-risk bets with real money. Keep true until
# the backtest justifies relaxing it.
LIVE_RISKLESS_ONLY=true
# Minimum fee-adjusted edge (probability units) required to place a REAL order.
MIN_EDGE_LIVE=0.03
# Only trade groups whose consensus probability sits in this "medium" band —
# avoids the 1-10% longshot tails where a single surprise wipes the book.
MIN_CONSENSUS=0.15
MAX_CONSENSUS=0.85
# Relative-value trigger: a member must deviate at least this much (prob units)
# from the group consensus before a convergence trade is considered.
DEVIATION_THRESHOLD=0.05
# Liquidity / quality floors.
MIN_DEPTH_CONTRACTS=10       # skip books thinner than this at the tradeable level
MAX_SPREAD=0.10              # skip books wider than this (prob units)
# Cluster (NLP) matching is the least trustworthy; require this similarity floor
# and never let a cluster-matched group place REAL money unless it clears review.
CLUSTER_TRUST_FLOOR=0.80
